model ServiceType {
  id                String  @id @default(uuid()) @db.Uuid
  name              String  @unique
  description       String?
  estimatedDuration Int? // in minutes
  basePrice         Float?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@index([name])
  @@index([isActive])
  @@map("service_types")
}
