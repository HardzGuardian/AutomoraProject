// ===========================================
// AUTOMORA BACKEND - PRISMA SCHEMA
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// ENUMS
// ===========================================

enum UserRole {
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
  CUSTOMER
}

// ===========================================
// MODELS
// ===========================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  avatar    String?
  deletedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  uploadedFiles  UploadedFile[]

  // Indexes
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UploadedFile {
  id           String @id @default(uuid()) @db.Uuid
  originalName String
  filename     String @unique
  mimeType     String
  size         Int
  path         String
  uploaderId   String @db.Uuid

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  uploader          User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  contractDocuments ContractDocument[]

  // Indexes
  @@index([uploaderId])
  @@index([mimeType])
  @@map("uploaded_files")
}

// ===========================================
// PERSON 2 — CLIENT MODULE
// ===========================================

enum ClientCategory {
  CORPORATE
  RETAIL
  GOVERNMENT
}

model Client {
  id          String         @id @default(uuid()) @db.Uuid
  companyName String
  industry    String?
  category    ClientCategory @default(CORPORATE)
  taxId       String?        // GST / Tax ID
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  notes       String?

  // Assignment — UNRESOLVED DECISION: Should sales see only assigned clients?
  assignedToId String? @db.Uuid

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  contacts  ClientContact[]
  sites     ClientSite[]
  contracts Contract[]
  assets    Asset[]

  // Indexes
  @@index([companyName])
  @@index([category])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @db.Uuid
  name      String
  role      String? // e.g. "Primary", "Billing", "Technical"
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([clientId])
  @@index([isPrimary])
  @@map("client_contacts")
}

model ClientSite {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  siteName String
  address  String?
  city     String?
  state    String?
  pincode  String?
  phone    String?
  notes    String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets  AssetSite[]

  // Indexes
  @@index([clientId])
  @@map("client_sites")
}

// ===========================================
// PERSON 2 — ASSET MODULE
// ===========================================

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  serialNumber    String    @unique
  model           String
  manufacturer    String?
  description     String?
  installDate     DateTime?
  warrantyExpiry  DateTime?
  isActive        Boolean   @default(true)
  notes           String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  clientId   String?        @db.Uuid
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sites      AssetSite[]
  contracts  ContractAsset[]

  // Indexes
  @@index([serialNumber])
  @@index([clientId])
  @@index([deletedAt])
  @@map("assets")
}

model AssetSite {
  id       String @id @default(uuid()) @db.Uuid
  assetId  String @db.Uuid
  siteId   String @db.Uuid

  createdAt DateTime @default(now())

  // Relations
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  site  ClientSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([assetId, siteId])
  @@map("asset_sites")
}

// ===========================================
// PERSON 2 — SERVICE TYPE MODULE
// ===========================================

model ServiceType {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  description       String?
  estimatedDuration Int?     // in minutes
  basePrice         Float?
  isActive          Boolean  @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contracts Contract[]

  // Indexes
  @@index([name])
  @@index([isActive])
  @@map("service_types")
}

// ===========================================
// PERSON 2 — CONTRACT MODULE
// ===========================================

enum ContractType {
  COMPREHENSIVE
  NON_COMPREHENSIVE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  contractNumber  String         @unique
  clientId        String         @db.Uuid
  type            ContractType   @default(COMPREHENSIVE)
  status          ContractStatus @default(DRAFT)
  serviceTypeId   String?        @db.Uuid

  // Dates
  startDate   DateTime
  endDate     DateTime
  renewalDate DateTime? // Calculated: endDate - 30 days

  // Financials
  value           Float?
  paymentTerms    String?
  billingFrequency PaymentFrequency?

  // Service terms
  includedVisits Int?
  notes          String?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceType  ServiceType?     @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  assets       ContractAsset[]
  documents    ContractDocument[]
  sla          ContractSLA?
  renewal      Renewal?
  reminders    ReminderLog[]

  // Indexes
  @@index([contractNumber])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([renewalDate])
  @@index([deletedAt])
  @@map("contracts")
}

model ContractAsset {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid
  assetId    String @db.Uuid

  createdAt DateTime @default(now())

  // Relations
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contractId, assetId])
  @@map("contract_assets")
}

model ContractDocument {
  id             String  @id @default(uuid()) @db.Uuid
  contractId     String  @db.Uuid
  uploadedFileId String  @db.Uuid
  documentType   String  @default("CONTRACT") // CONTRACT, AMENDMENT, ADDENDUM
  notes          String?

  createdAt DateTime @default(now())

  // Relations
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([documentType])
  @@map("contract_documents")
}

model ContractSLA {
  id                 String @id @default(uuid()) @db.Uuid
  contractId         String @unique @db.Uuid
  responseTimeHours  Int    // SLA response time in hours
  resolutionTimeHours Int   // SLA resolution time in hours
  penaltyClause      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_slas")
}

// ===========================================
// PERSON 2 — RENEWAL MODULE
// ===========================================

enum RenewalStatus {
  PENDING
  IN_DISCUSSION
  RENEWED
  NOT_RENEWED
}

model Renewal {
  id              String        @id @default(uuid()) @db.Uuid
  contractId      String        @unique @db.Uuid
  status          RenewalStatus @default(PENDING)
  quotesSent      Int           @default(0)
  lastContactDate DateTime?
  outcomeNotes    String?
  renewedValue    Float?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  followUps  RenewalFollowUp[]

  // Indexes
  @@index([contractId])
  @@index([status])
  @@map("renewals")
}

model RenewalFollowUp {
  id              String    @id @default(uuid()) @db.Uuid
  renewalId       String    @db.Uuid
  notes           String
  outcome         String?   // e.g. "CONTACTED", "QUOTE_SENT", "NO_RESPONSE"
  nextFollowUpDate DateTime?

  createdAt DateTime @default(now())

  // Relations
  renewal Renewal @relation(fields: [renewalId], references: [id], onDelete: Cascade)

  @@index([renewalId])
  @@map("renewal_follow_ups")
}

// ===========================================
// PERSON 2 — JOB TRACKING
// ===========================================

model ReminderLog {
  id           String @id @default(uuid()) @db.Uuid
  contractId   String @db.Uuid
  reminderType String // "30_DAY", "60_DAY", "90_DAY"
  sentAt       DateTime @default(now())

  // Relations
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, reminderType])
  @@index([contractId])
  @@index([reminderType])
  @@index([sentAt])
  @@map("reminder_logs")
}
