# ===========================================
# AUTOMORA BACKEND - ENVIRONMENT CONFIGURATION
# ===========================================

# DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automora?schema=public

# JWT - ACCESS TOKEN
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-this
JWT_EXPIRES_IN=15m

# JWT - REFRESH TOKEN
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long-change-this
JWT_REFRESH_EXPIRES_IN=7d

# SERVER
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# FILE UPLOADS
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AUTH RATE LIMITING (more restrictive)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# LOGGING
LOG_LEVEL=info

# PASSWORD SECURITY
BCRYPT_ROUNDS=12

# ACCOUNT SECURITY
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MS=900000

# PERSON 4 INTEGRATIONS (OPTIONAL)
# NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_PHONE=
PAYMENT_GATEWAY_NAME=unconfigured
PAYMENT_GATEWAY_WEBHOOK_SECRET=
ACCOUNTING_PROVIDER_NAME=unconfigured
# ACCOUNTING_API_URL=
ACCOUNTING_API_KEY=
